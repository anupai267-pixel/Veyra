# ==========================================
# VEYRA MARKETPLACE - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.local for local development.
# IMPORTANT: Keep real API keys private. Never commit .env or .env.local to version control.

# ------------------------------------------
# Supabase Configuration (Client & Backend)
# ------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Supabase Service Role Key (Backend Server Only - NEVER expose to frontend or VITE_ variables)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------
# OpenAI API Configuration (Backend Server Only)
# ------------------------------------------
# Used for server-side AI-generated product descriptions and auction insights.
# NEVER prefix with VITE_ or expose in browser code.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
